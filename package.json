{
  "name": "canvas-ai-website-builder",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "overrides": {
    "dompurify": "3.4.17"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "build": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=backend",
    "lint": "npm run lint --workspace=frontend",
    "test": "npm test --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "supabase": "^2.122.0"
  },
  "dependencies": {
    "monaco-editor": "0.56.0"
  }
}
