# Public Supabase project settings (same project as backend/.env).
# Never put SUPABASE_SERVICE_ROLE_KEY in a VITE_* variable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# Set true only after Google OAuth is enabled and tested in Supabase.
VITE_GOOGLE_AUTH_ENABLED=false

# Optional when the API is hosted at a different origin.
# VITE_API_URL=https://api.example.com/api
